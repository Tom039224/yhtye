{
  "name": "yhtye",
  "private": true,
  "license": "BSD-3-Clause",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:browser": "node scripts/dev-browser.mjs",
    "bridge": "cargo run -p yhtye-dev-bridge --",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:layout": "node scripts/check-layout.mjs",
    "gen:types": "YHTYE_UPDATE_TS=1 cargo test -p yhtye-core --lib api::typegen",
    "check:types": "cargo test -p yhtye-core --lib api::typegen",
    "tauri": "tauri",
    "record:fixtures": "YHTYE_RECORD_FIXTURE=1 cargo test -p yhtye-core --test core_facade"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
